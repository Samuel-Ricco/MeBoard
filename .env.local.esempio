# Copia questo file in `.env.local` e riempilo dal pannello Supabase:
#   Project Settings -> API Keys -> Publishable key
#
# `.env.local` NON entra nel repo. La chiave pubblicabile e' fatta per
# stare in un browser -- a proteggere i dati e' RLS -- ma legarla ai
# commit renderebbe impossibile ruotarla senza riscrivere la storia.
#
# La chiave SEGRETA (`sb_secret_...`) non va MAI qui: quella e' per i
# server, e da questa parte finirebbe dritta nel bundle.

VITE_SUPABASE_URL=https://srmjqlhprumjvocspbgj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
